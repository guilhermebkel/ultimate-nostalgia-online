{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/app/**/*.{ts,tsx}", "scripts/*.mjs", "src/**/*.test.{ts,tsx}", "tests/*.mjs", "e2e/*.mjs"],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.mjs", "tests/**/*.mjs", "e2e/**/*.mjs"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["@fontsource-variable/figtree", "@fontsource-variable/fredoka", "tailwindcss"]
}
