{
  "name": "ultimate-nostalgia-online",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ensure-deps": "node scripts/ensure-deps.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "lint:html": "html-validate dist",
    "lint:oxlint": "oxlint",
    "lint:eslint": "eslint --cache --cache-strategy content",
    "lint": "pnpm format:check && pnpm typecheck && pnpm lint:oxlint && pnpm lint:eslint && pnpm build && pnpm lint:html",
    "quality": "knip && jscpd && dpdm --no-warning --no-tree --exit-code circular:1 --transform \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:changed": "node scripts/test-changed.mjs",
    "test:e2e": "pnpm build && playwright test",
    "check:changed": "node scripts/check-changed.mjs",
    "check": "pnpm ensure-deps && pnpm lint && pnpm quality && pnpm test && pnpm test:e2e"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dpdm": "^4.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.14.0",
    "html-validate": "^11.21.1",
    "jscpd": "^5.4.3",
    "knip": "^6.47.0",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serve": "^14.2.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
